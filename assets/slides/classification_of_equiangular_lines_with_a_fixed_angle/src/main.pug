mixin graphCard(vertices, edges, label)
  - var graphXs = vertices.map(function(vertex) { return vertex[0]; })
  - var graphYs = vertices.map(function(vertex) { return vertex[1]; })
  - var graphMinX = Math.min.apply(null, graphXs)
  - var graphMaxX = Math.max.apply(null, graphXs)
  - var graphMinY = Math.min.apply(null, graphYs)
  - var graphMaxY = Math.max.apply(null, graphYs)
  - var graphPadding = 10
  - var graphViewportWidth = graphMaxX - graphMinX + 2 * graphPadding
  - var graphViewportHeight = 62
  - var graphCenterY = (graphMinY + graphMaxY) / 2
  - var graphViewBox = [graphMinX - graphPadding, graphCenterY - graphViewportHeight / 2, graphViewportWidth, graphViewportHeight].join(' ')
  .forbidden-card
    svg(viewBox=graphViewBox width=graphViewportWidth height=graphViewportHeight aria-label=label role="img")
      each edge in edges
        line(x1=vertices[edge[0]][0] y1=vertices[edge[0]][1] x2=vertices[edge[1]][0] y2=vertices[edge[1]][1])
      each vertex in vertices
        circle(cx=vertex[0] cy=vertex[1] r="5")

