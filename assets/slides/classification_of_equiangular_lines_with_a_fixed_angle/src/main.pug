      each dimension in comparisonDimensionsFirst
        td= dimension
    tr
      td!= label
      each value in firstValues
        td= value
  table.td-centered.dimension-value-table
    tr
      each dimension in comparisonDimensionsSecond
        td= dimension
    tr
      each value in secondValues
        td= value

